# https://ipfscluster.io/documentation/reference/configuration/
IPFS_API=http://127.0.0.1:5001
CLUSTER_IPFSHTTP_NODEMULTIADDRESS=/ip4/127.0.0.1/tcp/5001
CLUSTER_RESTAPI_HTTPLISTENMULTIADDRESS=/ip4/0.0.0.0/tcp/9094
IPFS_CLUSTER_IPFSPROXY_LISTENMULTIADDRESS=/ip4/0.0.0.0/tcp/9095
IPFS_CLUSTER_PATH=/uniondrive/ipfs-cluster
IPFS_CLUSTER_CONSENSUS=crdt
CLUSTER_CONSENSUS=crdt
IPFS_CLUSTER_DATASTORE=pebble
CLUSTER_DATASTORE=pebble
CLUSTER_REPLICATIONFACTORMIN=2
CLUSTER_REPLICATIONFACTORMAX=6
CLUSTER_DISABLEREPINNING=false
CLUSTER_DIALTIMEOUT=30s
CLUSTER_STATELESS_CONCURRENTPINS=5
CLUSTER_IPFSHTTP_PINTIMEOUT=15m0s

# NOTE: connection_manager (high/low water, grace period), pin_recover_interval
# and state_sync_interval are DELIBERATELY NOT set here.
#
# CLUSTER_* environment variables override service.json, so defining them here
# would silently defeat the RAM-aware sizing that
# ipfs-cluster/ipfs-cluster-container-init.d.sh writes into service.json: the jq
# would set high_water=150 on an 8 GB device and this file would immediately
# override it back to 400. The init script is the single source of truth for
# these values so that they can differ per RAM tier, which a static env file
# cannot express.
#
# The 32 GB tier in that script sets exactly the values this file used to hold
# (400/100/2m0s, 8m0s, 5m0s), so large devices are unaffected.